<settings>
    <mirrors>
        <mirror>
            <id>artifactory-central-proxy</id>
            <name>Artifactory Central Proxy</name>
            <url>https://artifactory.fsf.services.belgium.be/artifactory/iaa-maven-fts</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>

    <servers>
        <server>
            <!-- https://wiki.fsf.services.belgium.be/artifactory -->
            <id>artifactory-central-proxy</id>
            <username>${env.ARTIFACTORY_USER}</username>
            <password>${env.ARTIFACTORY_TOKEN}</password>
        </server>
    </servers>
</settings>
